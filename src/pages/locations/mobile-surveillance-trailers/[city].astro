---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import HeroImage from '../../../components/hero/HeroImage.astro';
import TrustStrip from '../../../components/sections/TrustStrip.astro';
import PageBody from '../../../components/sections/PageBody.astro';
import SchemaLocalBusiness from '../../../components/seo/SchemaLocalBusiness.astro';
import SchemaFAQ from '../../../components/seo/SchemaFAQ.astro';
import { heroImageUrl } from '../../../lib/heroImage.ts';

export async function getStaticPaths() {
  const all = await getCollection('pages');
  return all
    .filter((e) => e.data.collection === 'locations-city')
    .map((entry) => ({
      params: { city: entry.data.url.split('/').pop() },
      props: { entry }
    }));
}
const { entry } = Astro.props;
const page = entry.data;
const { Content } = await entry.render();
const parts = page.url.split('/');
const city = parts[parts.length - 1].replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase());
---
<Layout title={page.seoTitle} description={page.metaDescription} ogImage={page.ogImage} robots={page.robots} parent="City locations" h1={page.h1}>
  <SchemaLocalBusiness name={`VDS — ${city}`} description={page.metaDescription} url={page.canonical} locality={city} region="US" />
  <SchemaFAQ faqs={page.faq} />
  <HeroImage bgImage={heroImageUrl({ url: page.url, tags: page.tags, pageType: page.pageType, heroImage: page.heroImage })} eyebrow={page.heroEyebrow} h1={page.h1} subhead={page.heroSubhead} ctaPrimary={page.heroCTAPrimary} ctaSecondary={page.heroCTASecondary} stats={page.heroStats} />
  <TrustStrip />
  <section class="py-12 md:py-16 bg-white"><div class="container-main"><article class="prose-vds"><Content /></article></div></section>
  <PageBody body="" faq={page.faq} finalCTAHeading=