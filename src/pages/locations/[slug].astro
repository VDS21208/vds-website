---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeroImage from '../../components/hero/HeroImage.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import PageBodyEnhanced from '../../components/sections/PageBodyEnhanced.astro';
import SchemaArticle from '../../components/seo/SchemaArticle.astro';
import SchemaFAQ from '../../components/seo/SchemaFAQ.astro';
import { heroImageUrl } from '../../lib/heroImage.ts';

export async function getStaticPaths() {
  const all = await getCollection('pages');
  return all
    .filter((e) => e.data.collection === 'locations-state')
    .map((entry) => ({
      params: { slug: entry.data.url.split('/').pop() },
      props: { entry, allEntries: all }
    }));
}
const { entry, allEntries } = Astro.props;
const page = entry.data;
const { Content } = await entry.render();

// Find 3 related pages in the same collection (excluding current)
const related = allEntries
  .filter((e: any) => e.data.collection === 'locations-state' && e.data.url !== page.url)
  .slice(0, 3)
  .map((e: any) => ({ url: e.data.url, title: e.data.h1, description: e.data.metaDescription }));
---
<Layout
  title={page.seoTitle}
  description={page.metaDescription}
  ogTitle={page.ogTitle}
  ogDescription={page.ogDescription}
  ogImage={page.ogImage}
  ogType={page.ogType || "article"}
  robots={page.robots}
  parent="Locations"
  h1={page.h1}
>
  <SchemaArticle headline={page.h1} description={page.metaDescription} url={page.canonical} keywords={page.tags} />
  <SchemaFAQ faqs={page.faq} />
  <HeroImage bgImage={heroImageUrl({ url: page.url, tags: page.tags, pageType: page.pageType, heroImage: page.heroImage })} eyebrow={page.heroEyebrow} h1={page.h1} subhead={page.heroSubhead} ctaPrimar