---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact VDS" description="Talk to Vision Detection Systems by phone or email. Pikesville, MD HQ." parent="Home" h1="Contact us">
  <section class="bg-navy text-white py-16">
    <div class="container-main max-w-3xl">
      <div class="eyebrow mb-3">Contact</div>
      <h1 class="text-hero font-display mb-6">Talk to VDS.</h1>
      <div class="grid md:grid-cols-2 gap-6 mt-8">
        <div class="bg-white/5 border border-white/10 rounded-md p-6">
          <div class="eyebrow mb-2">Sales</div>
          <a href="tel:+14104011986" class="block text-2xl font-display mb-1">(410) 401-1986</a>
          <a href="mailto:sales@visiondetectionsystems.com" class="block text-sm text-orange">sales@visiondetectionsystems.com</a>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-md p-6">
          <div class="eyebrow mb-2">Headquarters</div>
          <div class="text-sm text-white/85">Pikesville, MD 21208</div>
          <div class="text-sm text-white/70 mt-1">Mon–Fri, 8a–6p ET</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-md p-6">
          <div class="eyebrow mb-2">Press / media</div>
          <a href="mailto:press@visiondetectionsystems.com" class="text-sm text-orange">press@visiondetectionsystems.com</a>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-md p-6">
          <div class="eyebrow mb-2">Channel / dealers</div>
          <a href="/partners/become-a-dealer" class="text-sm text-orange">partners@visiondetectionsystems.com</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
