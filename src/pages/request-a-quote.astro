---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/forms/QuoteForm.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
---
<Layout
  title="Request a quote — VDS"
  description="Get a custom mobile surveillance quote. VDS responds within one business hour."
  parent="Home"
  h1="Request a quote"
>
  <section class="bg-navy text-white py-16">
    <div class="container-main grid md:grid-cols-2 gap-12 items-start">
      <div>
        <div class="eyebrow mb-3">Get a quote</div>
        <h1 class="text-hero font-display mb-6">Talk to a VDS specialist.</h1>
        <p class="text-lg text-white/80 mb-6">Most quote requests get a response within one business hour. Your specialist will help size the right configuration for your project, walk you through pricing, and confirm deployment lead time.</p>
        <div class="bg-white/5 border-l-4 border-orange rounded-md p-5">
          <div class="text-sm text-white/85 mb-2">What happens next:</div>
          <ol class="text-sm text-white/70 space-y-1.5 list-decimal pl-5">
            <li>VDS rep calls or emails within one business hour</li>
            <li>15-minute discovery call to scope the project</li>
            <li>Written quote within 24 hours</li>
            <li>Deployment in 72 hours of contract signing</li>
          </ol>
        </div>
      </div>
      <div>
        <QuoteForm />
      </div>
    </div>
  </section>
  <TrustStrip />
</Layout>
