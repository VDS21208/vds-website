---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroImage from '../components/hero/HeroImage.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import FinalCTAStrip from '../components/sections/FinalCTAStrip.astro';
import Card from '../components/ui/Card.astro';
import SchemaFAQ from '../components/seo/SchemaFAQ.astro';

const all = await getCollection('pages');
const entry = all.find((e) => e.data.url === '/');
const home = entry?.data || {
  seoTitle: "VDS — Mobile Security Infrastructure", metaDescription: "Solar-autonomous trailers + AI VMS + 24/7 US SOC.",
  h1: "Security infrastructure.", heroSubhead: "Solar-autonomous hardware. AI VisionStream cloud platform. 24/7 in-house US Security Operations Center. Under one roof.",
  heroEyebrow: "HARDWARE + CLOUD VMS + 24/7 US SOC",
  heroStats: ["$1,500/mo · Starting price", "< 30 min · Deploy time", "97% · False alarm cut", "500+ · Deployments"],
  faq: []
};
---
<Layout
  title={home.seoTitle}
  description={home.metaDescription}
  ogTitle={home.ogTitle || home.seoTitle}
  ogDescription={home.ogDescription || home.metaDescription}
  ogImage={home.ogImage}
  announcementBar="Now deploying Q2 2026 — most sites active within 72 hours · Call (410) 401-1986"
>
  <SchemaFAQ faqs={home.faq || []} />

  <section class="relative overflow-hidden bg-navy text-white">
    <div class="container-main py-20 md:py-28 lg:py-32 relative z-10">
      <div class="max-w-3xl">
        <div class="eyebrow mb-4">{home.heroEyebrow || "MOBILE SECURITY INFRASTRUCTURE"}</div>
        <h1 class="text-hero font-display mb-6 leading-tight">
          Security infrastructure.<br>
          <span class="text-orange">Not just cameras.</span>
        </h1>
        <p class="text-lg md:text-xl text-white/80 mb-8 leading-relaxed max-w-2xl">
          {home.heroSubhead || "Solar-autonomous hardware. AI VisionStream cloud platform. 24/7 in-house US SOC. Under one roof."}
        </p>
        <div class="flex flex-wrap gap-3 mb-12">
          <a href="/request-a-quote" class="btn-primary btn-large">Request a free quote →</a>
          <a href="/products" class="btn-secondary btn-large border-white text-white hover:bg-white/10">See our products</a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-8 border-t border-white/10">
          {(home.heroStats || []).map((s) => {
            const parts = s.split(/\s+·\s+|\s{2,}/);
            return (
              <div>
                <div class="text-2xl md:text-3xl font-display font-medium text-orange">{parts[0]}</div>
                <div class="text-xs uppercase tracking-wide mt-1 text-white/60">{parts.slice(1).join(' ')}</div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <section class="py-20 bg-white">
    <div class="container-main">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="eyebrow mb-3">The problem</div>
        <h2 class="text-h2 font-display mb-4">The three gaps in site security</h2>
        <p class="text-slate">Most sites are protected by some combination of three things — and each has a fatal flaw.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <Card title="Guards: expensive and inconsistent" description="$60K–$110K per FTE per year for 24/7 coverage. No video evidence." cta="Compare VDS vs guards" href="/compare/vds-vs-security-guards" />
        <Card title="Fixed cameras: can't move" description="Wired power and network requirements add days of install lead time." cta="Compare VDS vs fixed cameras" href="/compare/vds-vs-fixed-cameras" />
        <Card title="Smart-city programs: exposed data" description="Public ALPR networks have exposed footage. Jan 2026 Flock event." cta="See our privacy model" href="/about-us/trust-center" />
      </div>
    </div>
  </section>

  <section class="py-20 bg-offwhite">
    <div class="container-main">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="eyebrow mb-3">Flagship products</div>
        <h2 class="text-h2 font-display mb-4">Three trailers, every site</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <Card variant="dark" href="/products/sky-guard-mobile-surveillance-trailer" eyebrow="Flagship · $2,200/mo" title="Sky Guard MSU" description="Thermal + radar + 4K + LPR + active deterrence in one solar-autonomous trailer." cta="Spec sheet" />
        <Card variant="dark" href="/products/swift-deploy-surveillance-trailer" eyebrow="Most popular · $1,500/mo" title="Swift Deploy" description="HD PTZ with 30x optical zoom, dual-spectrum night vision, AI analytics." cta="Spec sheet" />
        <Card variant="dark" href="/products/boundary-guard-pro" eyebrow="Perimeter · $1,800/mo" title="Boundary Guard Pro" description="500+ linear feet of fence-line coverage with no blind spots." cta="Spec sheet" />
      </div>
    </div>
  </section>

  <section class="py-20 bg-navy text-white">
    <div class="container-main">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="eyebrow mb-3">Case study</div>
        <h2 class="text-h2 font-display mb-2">$340,800 saved in 12 months</h2>
        <p class="text-white/70">National GC · $28M Mid-Atlantic project · 2 Swift Deploy + 3 Solar Camera Poles</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="bg-white/5 border-l-4 border-orange rounded-md p-6 text-center"><div class="text-3xl font-display text-orange mb-2">73%</div><div class="text-xs uppercase tracking-wider text-white/60">Theft reduction</div></div>
        <div class="bg-white/5 border-l-4 border-orange rounded-md p-6 text-center"><div class="text-3xl font-display text-orange mb-2">$0</div><div class="text-xs uppercase tracking-wider text-white/60">Insurance claims</div></div>
        <div class="bg-white/5 border-l-4 border-orange rounded-md p-6 text-center"><div class="text-3xl font-display text-orange mb-2">$32K → $4K</div><div class="text-xs uppercase tracking-wider text-white/60">Monthly security cost</div></div>
      </div>
      <div class="text-center mt-8">
        <a href="/resources/case-studies/mid-atlantic-gc" class="inline-flex items-center text-orange hover:text-white text-sm font-medium">Read the full case study →</a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container-main">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="eyebrow mb-3">Industries</div>
        <h2 class="text-h2 font-display mb-4">17 verticals · one platform</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <Card href="/industries/construction-site-security" title="Construction" description="$340,800 saved per project." />
        <Card href="/industries/utility-substation-security" title="Utilities" description="NERC CIP-014. Substation perimeter." />
        <Card href="/industries/retail-shopping-center-security" title="Retail" description="ORC + parking lot." />
        <Card href="/industries/automotive-dealership-security" title="Auto dealerships" description="Catalytic converter + vehicle theft." />
        <Card href="/industries/parking-lot-garage-security" title="Parking & garages" description="24/7 after-hours coverage." />
        <Card href="/industries/public-safety-law-enforcement-surveillance" title="Government & LE" description="NDAA Section 889." />
      </div>
      <div class="text-center mt-8">
        <a href="/industries" class="inline-flex items-center text-orange hover:text-orange-dark text-sm font-medium">See all 17 industries →</a>
      </div>
    </div>
  </section>

  {home.faq && home.faq.length > 0 && <FAQAccordion heading="Frequently asked questions" faqs={home.faq} />}

  <FinalCTAStrip
    heading={home.finalCTAHeading || "Your site. Protected. Starting this week."}
    body={home.finalCTABody || "Most quotes come back within one business hour."}
    buttons={home.finalCTAButtons && home.finalCTAButtons.length ? home.finalCTAButtons : [
      { label: "Request a quote", url: "/request-a-quote" },
      { label: "Schedule a demo", url: "/schedule-a-demo" }
    ]}
  />
</Layout>
