---
import nav from '../../data/nav.json';
---
<footer class="bg-navy text-white pt-16 pb-8">
  <div class="container-main">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 mb-12">
      <div class="col-span-2 md:col-span-1">
        <div class="text-orange font-display text-xl mb-3">VDS</div>
        <p class="text-xs text-white/70 leading-relaxed mb-4">America's integrated mobile security infrastructure company.</p>
        <a href="tel:+14104011986" class="block text-sm text-white/85 hover:text-white mb-1">(410) 401-1986</a>
        <a href="mailto:info@visiondetectionsystems.com" class="block text-xs text-white/70 hover:text-white">info@visiondetectionsystems.com</a>
      </div>
      {nav.map(section => (
        <div>
          <div class="text-sm font-medium mb-3">{section.label}</div>
          <ul class="space-y-2">
            {section.primary.slice(0, 5).map((item: any) => (
              <li><a href={item.url} class="text-xs text-white/70 hover:text-white transition-colors">{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="border-t border-white/10 pt-6 flex flex-wrap items-center justify-between gap-4">
      <div class="text-xs text-white/50">
        © {new Date().getFullYear()} Vision Detection Systems. All rights reserved. ·
        <a href="/privacy-policy" class="hover:text-white/80 underline-offset-2">Privacy</a> ·
        <a href="/terms-of-service" class="hover:text-white/80 underline-offset-2">Terms</a> ·
        <a href="/sitemap-page" class="hover:text-white/80 underline-offset-2">Sitemap</a>
      </div>
      <div class="text-xs text-white/40 uppercase tracking-wider flex flex-wrap items-center gap-3">
        <span>NDAA 889 Compliant</span>
        <span>·</span>
        <span>AWS Cloud Partner</span>
        <span>·</span>
        <span>Made in Pikesville, MD</span>
      </div>
    </div>
  </div>
</footer>
