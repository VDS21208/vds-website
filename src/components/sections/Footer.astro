---
import nav from '../../data/nav.json';
import Icon from '../icons/Icon.astro';
---
<footer class="bg-navy text-white pt-20 pb-10 relative overflow-hidden">
  <div class="hero-orb-layer">
    <div class="gradient-orb gradient-orb-orange" style="width: 500px; height: 500px; top: 30%; right: -200px; opacity: 0.15;"></div>
  </div>
  <div class="container-wide relative z-10">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-10 mb-14">
      <div class="col-span-2 md:col-span-2">
        <a href="/" class="inline-flex items-center gap-3 mb-5 group">
          <img src="/assets/vds-mark.svg" alt="" class="h-12 w-auto" style="filter: invert(1) brightness(2);" />
          <div class="flex flex-col leading-tight">
            <span class="text-[0.625rem] uppercase tracking-[0.2em] text-white/55 font-medium">Vision Detection</span>
            <span class="text-xl text-orange font-display font-semibold tracking-wide -mt-1">Systems</span>
          </div>
        </a>
        <p class="text-sm text-white/70 leading-relaxed mb-6 max-w-xs">America's integrated mobile security infrastructure company. Solar-autonomous hardware. Cloud VMS. 24/7 US SOC.</p>
        <a href="tel:+14104011986" class="block text-base text-white hover:text-orange mb-2 font-medium inline-flex items-center gap-2"><Icon name="phone" size={16} /> (410) 401-1986</a>
        <a href="mailto:info@visiondetectionsystems.com" class="block text-sm text-white/70 hover:text-white inline-flex items-center gap-2"><Icon name="mail" size={14} /> info@visiondetectionsystems.com</a>
      </div>
      {nav.map(section => (
        <div>
          <div class="text-xs uppercase tracking-[0.15em] text-orange font-medium mb-4">{section.label}</div>
          <ul class="space-y-2.5">
            {section.primary.slice(0, 5).map((item: any) => (
              <li><a href={item.url} class="text-sm text-white/70 hover:text-white transition-colors">{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="border-t border-white/10 pt-8 flex flex-wrap items-center justify-between gap-4">
      <div class="text-xs text-white/50">
        © {new Date().getFullYear()} Vision Detection Systems · 
        <a href="/privacy-policy" class="hover:text-white/80 underline-offset-2">Privacy</a> · 
        <a href="/terms-of-service" class="hover:text-white/80 underline-offset-2">Terms</a> · 
        <a href="/sitemap-page" class="hover:text-white/80 underline-offset-2">Sitemap</a>
      </div>
      <div class="text-xs text-white/40 uppercase tracking-[0.15em] flex flex-wrap items-center gap-4">
        <span>NDAA 889</span>
        <span class="w-1 h-1 rounded-full bg-white/30"></span>
        <span>AWS Partner</span>
        <span class="w-1 h-1 rounded-full bg-white/30"></span>
        <span>Made in Pikesville, MD</span>
      </div>
    </div>
  </div>
</footer>
