---
const badges = ["NDAA Section 889", "AWS Cloud Partner", "Made in Pikesville, MD", "Camera Agnostic", "Est. 2017", "500+ deployments"];
---
<section class="bg-offwhite border-y border-slate-200 py-5">
  <div class="container-wide flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs uppercase tracking-[0.15em] text-slate-600 font-medium">
    <span class="text-navy font-semibold">Trusted by 500+ sites</span>
    {badges.map(b => (<>
      <span class="w-1 h-1 rounded-full bg-slate-400"></span>
      <span>{b}</span>
    </>))}
  </div>
</section>
