---
// Renders the AI VisionStream logo + tagline — used as a brand strip on platform pages
---
<section class="bg-navy text-white border-y border-orange/20 py-12 md:py-14" data-no-reveal>
 <div class="container-wide">
 <div class="flex flex-col md:flex-row items-center justify-between gap-8">
 <div class="flex items-center gap-6">
 <img src="/assets/ai-visionstream-logo-full.png" alt="AI VisionStream" class="h-24 md:h-32 w-auto object-contain" />
 <div class="hidden md:block w-px h-16 bg-white/15"></div>
 <div class="hidden md:block">
 <div class="text-xs uppercase tracking-[0.2em] text-orange font-medium mb-1">The platform</div>
 <div class="text-sm text-white/75 leading-relaxed max-w-md">VDS's cloud-native video management platform. AWS-hosted, camera-agnostic, NDAA-compliant.</div>
 </div>
 </div>
 <div class="flex flex-wrap items-center gap-4 text-xs uppercase tracking-[0.15em] text-white/55">
 <span class="inline-flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-orange"></span> Camera Agnostic</span>
 <span class="inline-flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-orange"></span> 95%+ LPR Accuracy</span>
 <span class="inline-flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-orange"></span> &lt;60s SOC</span>
 <span class="inline-flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-orange"></span> AWS US-only</span>
 </div>
 </div>
 </div>
</section>
