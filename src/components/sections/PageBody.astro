---
import Markdown from '../ui/Markdown.astro';
import FAQAccordion from './FAQAccordion.astro';
import FinalCTAStrip from './FinalCTAStrip.astro';
export interface Props {
 body: string;
 faq?: Array<{q: string, a: string}>;
 finalCTAHeading?: string;
 finalCTABody?: string;
 finalCTAButtons?: Array<{label: string, url: string}>;
}
const { body, faq = [], finalCTAHeading, finalCTABody, finalCTAButtons = [] } = Astro.props;
---
<section class="py-12 md:py-16 bg-white">
 <div class="container-main">
 <Markdown content={body} />
 </div>
</section>
{faq && faq.length > 0 && <FAQAccordion faqs={faq} />}
{finalCTAHeading && (
 <FinalCTAStrip heading={finalCTAHeading} body={finalCTABody} buttons={finalCTAButtons} />
)}
