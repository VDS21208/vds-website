---
import Icon from '../icons/Icon.astro';
import FAQAccordion from './FAQAccordion.astro';
import FinalCTAStrip from './FinalCTAStrip.astro';

export interface Props {
  Content: any;
  page: any;
  related?: Array<{ url: string; title: string; description?: string }>;
}

const { Content, page, related = [] } = Astro.props;

const statSplitter = new RegExp('\\s+\\u00B7\\s+|\\s{2,}');
const parsedStats = (page.heroStats || []).slice(0, 4).map((s) => {
  const parts = s.split(statSplitter);
  return { value: parts[0] || '', label: parts.slice(1).join(' ') };
});

const relatedTop = related.slice(0, 3);
const finalButtons = page.finalCTAButtons || [];
const hasFAQ = page.faq && page.faq.length > 0;
const ctaHeading = page.finalCTAHeading;
const ctaBody = page.finalCTABody;
---
<section class="relative bg-white">
  <div class="absolute inset-x-0 top-0 h-64 bg-gradient-to-b from-offwhite/40 to-transparent pointer-events-none"></div>
  <div class="container-main py-20 md:py-28 relative">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12 lg:gap-16 max-w-6xl mx-auto">
      <!-- Main column: prose + stat callouts -->
      <div>
        <article class="prose-vds">
          <Content />
        </article>

        {parsedStats.length > 0 && (
          <aside class="my-14 grid grid-cols-2 md:grid-cols-4 gap-4 not-prose border-y border-slate-200 py-10">
            {parsedStats.map((stat) => (
              <div class="border-l-2 border-orange pl-4 py-2">
                <div class="font-display text-3xl md:text-4xl text-orange leading-none" data-target={stat.value}>{stat.value}</div>
                {stat.label && <div class="text-xs uppercase tracking-wider text-slate-500 mt-2">{stat.label}</div>}
              </div>
            ))}
          </aside>
        )}
      </div>

      <!-- Sticky conversion sidebar -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-4">
          <!-- Quote CTA card -->
          <div class="bg-navy text-white rounded-xl p-7 shadow-lg relative overflow-hidden">
            <div class="absolute inset-0 opacity-30" style="background: radial-gradient(circle at top right, rgba(232,98,26,0.4), transparent 60%);"></div>
            <div class="relative">
              <div class="text-[0.625rem] uppercase tracking-[0.2em] text-orange font-medium mb-2">Ready to deploy</div>
              <h3 class="font-display text-xl mb-2 leading-tight">Get your custom quote in 24 hours</h3>
              <p class="text-sm text-white/75 leading-relaxed mb-5">US-engineered. Solar-autonomous. Live AI + 24/7 SOC. NDAA-compliant.</p>
              <a href="/request-a-quote" class="flex items-center justify-center gap-2 bg-orange hover:bg-orange-dark text-white font-medium py-3 px-4 rounded-sm transition-all w-full text-sm">
                Request a quote <Icon name="arrow-right" size={14} />
              </a>
              <a href="/schedule-a-demo" class="flex items-center justify-center gap-2 mt-2 border border-white/30 hover:border-white text-white font-medium py-3 px-4 rounded-sm transition-all w-full text-sm">
                Schedule a demo
              </a>
            </div>
          </div>

          <!-- Trust card -->
          <div class="bg-white border border-slate-200 rounded-xl p-6">
            <div class="text-[0.625rem] uppercase tracking-[0.2em] text-orange font-medium mb-3">Why VDS</div>
            <ul class="space-y-2.5 text-sm text-slate-700">
              <li class="flex items-start gap-2">
                <span class="text-orange mt-0.5"><Icon name="shield" size={14} /></span>
                <span>NDAA Section 889 compliant</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-orange mt-0.5"><Icon name="shield" size={14} /></span>
                <span>US-engineered &amp; assembled</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-orange mt-0.5"><Icon name="shield" size={14} /></span>
                <span>24/7 US-based SOC monitoring</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-orange mt-0.5"><Icon name="shield" size={14} /></span>
                <span>Solar + battery, no trenching</span>
              </li>
            </ul>
          </div>

          <!-- Contact callout -->
          <a href="tel:+14104011986" class="block bg-offwhite border border-slate-200 rounded-xl p-5 hover:border-orange transition-colors group">
            <div class="text-[0.625rem] uppercase tracking-[0.2em] text-slate-500 font-medium mb-1.5">Talk to us</div>
            <div class="flex items-center gap-2 text-navy font-display text-lg group-hover:text-orange transition-colors">
              <Icon name="phone" size={18} />
              (410) 401-1986
            </div>
            <div class="text-xs text-slate-500 mt-1">Mon–Fri 8am–6pm ET</div>
          </a>
        </div>
      </aside>
    </div>

    <!-- Mobile-only CTA card after content -->
    <div class="lg:hidden mt-12 max-w-2xl mx-auto bg-navy text-white rounded-xl p-7 relative overflow-hidden">
      <div class="absolute inset-0 opacity-30" style="background: radial-gradient(circle at top right, rgba(232,98,26,0.4), transparent 60%);"></div>
      <div class="relative">
        <h3 class="font-display text-xl mb-2">Ready to deploy?</h3>
        <p class="text-sm text-white/75 mb-5">Custom quote in 24 hours. US-engineered. NDAA-compliant.</p>
        <div class="grid grid-cols-2 gap-2">
          <a href="/request-a-quote" class="inline-flex items-center justify-center gap-2 bg-orange text-white font-medium py-3 px-4 rounded-sm text-sm">
            Quote <Icon name="arrow-right" size={14} />
          </a>
          <a href="tel:+14104011986" class="inline-flex items-center justify-center gap-2 border border-white/30 text-white font-medium py-3 px-4 rounded-sm text-sm">
            <Icon name="phone" size={14} /> Call
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{hasFAQ && <FAQAccordion faqs={page.faq} />}

{relatedTop.length > 0 && (
  <section class="bg-offwhite py-20">
    <div class="container-main">
      <div class="eyebrow mb-3">Related</div>
      <h2 class="font-display mb-10 text-navy text-3xl md:text-4xl">Continue reading</h2>
      <div class="grid md:grid-cols-3 gap-5">
        {relatedTop.map((r) => (
          <a href={r.url} class="card-hover bg-white border border-slate-200 rounded-lg p-7 group block">
            <h3 class="font-display text-xl text-navy mb-3 leading-snug">{r.title}</h3>
            <p class="text-[0.95rem] text-slate-600 leading-relaxed mb-4">{r.description}</p>
            <span class="inline-flex items-center gap-1 text-sm text-orange font-medium">Read more <Icon name="arrow-right" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{ctaHeading && <FinalCTAStrip heading={ctaHeading} body={ctaBody} buttons={finalButtons} />}
