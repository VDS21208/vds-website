---
export interface Props { faqs: Array<{q: string, a: string}>; heading?: string }
const { faqs, heading = "Frequently asked questions" } = Astro.props;
if (!faqs || faqs.length === 0) return null;
---
<section class="py-16 md:py-24 bg-white">
  <div class="container-main max-w-3xl">
    <div class="eyebrow mb-3">FAQ</div>
    <h2 class="text-h2 font-display mb-8">{heading}</h2>
    <div class="space-y-1">
      {faqs.map(({q, a}) => (
        <details class="group border-b border-slate-200 py-4">
          <summary class="flex items-start justify-between cursor-pointer text-base font-medium text-navy gap-4 list-none [&::-webkit-details-marker]:hidden">
            <span class="flex-1 faq-question">{q}</span>
            <span class="text-orange text-xl flex-shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="mt-3 text-sm text-slate leading-relaxed faq-answer">{a}</div>
        </details>
      ))}
    </div>
  </div>
</section>
