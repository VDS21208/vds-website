---
<!-- THREAT GRID -->
<section class="bg-offwhite py-20 md:py-24 relative overflow-hidden">
  <div class="dot-pattern-light absolute inset-0 opacity-50"></div>
  <div class="container-wide relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 mb-12 items-end">
      <div class="lg:col-span-7">
        <div class="eyebrow mb-3">The problem</div>
        <h2 class="font-display text-navy text-3xl md:text-4xl leading-tight">What's putting<br/><span class="gradient-text-dark">your sites at risk.</span></h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-slate-600 leading-relaxed">VDS targets the threat patterns this industry sees every day — pre-mapped to the AI analytics that catch them.</p>
      </div>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {d.threats.map((t) => (
        <div class="bg-white border border-slate-200 rounded-xl p-7 hover:border-orange transition-colors">
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-orange/10 text-orange"><Icon name={t.icon} size={18} /></span>
            {t.stat && <span class="font-display text-2xl text-orange">{t.stat}</span>}
          </div>
          <h3 class="font-display text-lg text-navy mb-2">{t.label}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{t.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ANALYTICS FOR THIS INDUSTRY -->
<section class="bg-white py-20 md:py-24">
  <div class="container-wide">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-12">
      <div class="max-w-2xl">
        <div class="eyebrow mb-3">AI Analytics</div>
        <h2 class="font-display text-navy text-3xl md:text-4xl leading-tight">The analytics<br/><span class="gradient-text-dark">that solve this industry.</span></h2>
      </div>
      <a href="/platform/analytics/" class="inline-flex items-center gap-2 text-navy hover:text-orange font-medium border-b border-navy/30 hover:border-orange pb-1 transition-colors">All AI analytics <Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {d.analytics.map((a) => (
        <a href={`/platform/analytics/${a.slug}/`} class="group bg-offwhite border border-slate-200 rounded-xl overflow-hidden hover:border-orange hover:shadow-lg transition-all hover:-translate-y-1">
          <div class="aspect-[16/10] bg-navy overflow-hidden relative">
            <img src={a.image} alt={a.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="p-5">
            <h3 class="font-display text-base text-navy group-hover:text-orange transition-colors mb-1">{a.name}</h3>
            <span class="inline-flex items-center gap-1 text-xs text-orange font-medium group-hover:gap-2 transition-all">Learn more <Icon name="arrow-right" size={12} /></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- OUTCOMES BAND -->
<section class="bg-navy text-white py-20 md:py-24 relative overflow-hidden">
  <div class="dot-pattern absolute inset-0 opacity-15"></div>
  <div class="hero-orb-layer">
    <div class="gradient-orb gradient-orb-orange" style="width:600px;height:600px;top:-200px;right:-150px;opacity:0.2;"></div>
  </div>
  <div class="container-wide relative z-10">
    <div class="eyebrow mb-3">Outcomes</div>
    <h2 class="font-display text-3xl md:text-4xl leading-tight mb-12 max-w-3xl">What field deployments<br/><span class="gradient-text">actually produce.</span></h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10">
      {d.outcomes.map((o) => (
        <div>
          <div class="font-display text-5xl md:text-6xl text-orange leading-none">{o.stat}</div>
          <div class="text-xs uppercase tracking-[0.15em] text-white/55 mt-3">{o.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
