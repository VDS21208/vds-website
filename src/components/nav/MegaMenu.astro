---
import nav from '../../data/nav.json';
import Icon from '../icons/Icon.astro';
export interface Props { activeUrl?: string }
const { activeUrl } = Astro.props;
---
<div class="hidden lg:block">
  {nav.map((section) => (
    <div class="absolute left-0 right-0 top-full bg-navy-light text-white shadow-2xl border-t border-orange/30 opacity-0 invisible pointer-events-none transition-all duration-200" data-megamenu={section.label}>
      <div class="container-wide py-8">
        <div class="grid grid-cols-12 gap-10">
          <!-- Left section: Primary + Supporting links (merged, no labels) -->
          <div class="col-span-7 grid grid-cols-2 gap-x-12 gap-y-2">
            {[...section.primary, ...section.supporting].map((item: any, i: number) => (
              <a href={item.url} class="group flex items-start gap-3 py-2 px-3 -mx-3 rounded-md hover:bg-white/5 transition-colors">
                <span class="text-orange/40 group-hover:text-orange transition-colors mt-0.5">
                  <Icon name="arrow-right" size={14} />
                </span>
                <div class="flex-1">
                  <div class="text-sm font-medium text-white group-hover:text-orange transition-colors">{item.label}</div>
                </div>
              </a>
            ))}
          </div>
          <!-- Right: Featured + CTA -->
          <div class="col-span-5 border-l border-white/10 pl-10">
            {section.featured.length > 0 && (
              <div class="bg-navy rounded-lg p-5 border border-white/10 border-l-4 border-l-orange mb-5">
                <div class="text-[0.625rem] uppercase tracking-[0.2em] text-orange font-medium mb-2">Featured</div>
                <div class="text-base font-display font-medium text-white mb-1.5">{section.featured[0]?.label}</div>
                <p class="text-xs text-white/65 leading-relaxed mb-3">{section.featured[0]?.notes || ''}</p>
                <a href={section.featured[0]?.url} class="inline-flex items-center gap-1 text-xs text-gold hover:text-orange font-medium transition-all hover:gap-2">
                  Learn more <Icon name="arrow-right" size={12} />
                </a>
              </div>
            )}
            <div class="flex flex-col gap-2">
              {section.cta.map((item: any) => (
                <a
                  href={item.url}
                  class={item.type === 'cta-primary'
                    ? 'block text-center bg-orange hover:bg-orange-dark text-white text-xs font-medium py-2.5 px-4 rounded-sm transition-all'
                    : 'block text-center border border-white/30 hover:border-white/50 hover:bg-white/5 text-white text-xs py-2.5 px-4 rounded-sm transition-all'}
                >{item.label}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}
</div>
<script>
  const navItems = document.querySelectorAll('[data-nav-trigger]');
  const drawers = document.querySelectorAll('[data-megamenu]');
  let activeDrawer: HTMLElement | null = null;
  let closeTimer: number | undefined;

  const closeAll = () => {
    drawers.forEach(d => {
      const el = d as HTMLElement;
      el.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
      el.classList.add('opacity-0', 'invisible', 'pointer-events-none');
    });
    activeDrawer = null;
  };
  const open = (label: string) => {
    closeAll();
    const drawer = document.querySelector(`[data-megamenu="${label}"]`) as HTMLElement;
    if (drawer) {
      drawer.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      drawer.classList.add('opacity-100', 'visible', 'pointer-events-auto');
      activeDrawer = drawer;
    }
  };
  navItems.forEach(item => {
    const label = item.getAttribute('data-nav-trigger');
    if (!label) return;
    item.addEventListener('mouseenter', () => {
      if (closeTimer) window.clearTimeout(closeTimer);
      open(label);
    });
    item.addEventListener('mouseleave', () => {
      closeTimer = window.setTimeout(closeAll, 400);
    });
    item.addEventListener('focus', () => open(label));
  });
  drawers.forEach(d => {
    d.addEventListener('mouseenter', () => { if (closeTimer) window.clearTimeout(closeTimer); });
    d.addEventListener('mouseleave', () => { closeTimer = window.setTimeout(closeAll, 400); });
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
</script>
