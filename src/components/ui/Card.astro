---
export interface Props {
  href?: string;
  title: string;
  description?: string;
  eyebrow?: string;
  cta?: string;
  variant?: 'light' | 'dark';
}
const { href, title, description, eyebrow, cta, variant = 'light' } = Astro.props;
const Tag = href ? 'a' : 'div';
const base = variant === 'dark'
  ? 'block bg-navy-light text-white border border-white/10 hover:border-orange'
  : 'block bg-white text-navy border border-slate-200 hover:border-orange';
---
<Tag href={href} class={`${base} rounded-md p-6 card-hover group`}>
  {eyebrow && <div class="eyebrow mb-2">{eyebrow}</div>}
  <h3 class="text-lg font-medium font-display mb-2 group-hover:text-orange transition-colors">{title}</h3>
  {description && <p class={`text-sm leading-relaxed ${variant === 'dark' ? 'text-white/70' : 'text-slate'}`}>{description}</p>}
  {cta && <div class="text-xs text-orange mt-3 font-medium">{cta} →</div>}
</Tag>
