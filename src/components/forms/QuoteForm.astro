---
// Form A: Request a Quote (2-step)
// Routes to Salesforce Web-to-Lead. Replace SF_WEB_TO_LEAD_ENDPOINT and oid with real values pre-launch.
const oid = "PLACEHOLDER_SALESFORCE_OID";
const sfEndpoint = "https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8";
---
<form id="form-quote" action={sfEndpoint} method="POST" class="bg-white border border-slate-200 rounded-md p-6 md:p-8 max-w-2xl space-y-4">
 <input type="hidden" name="oid" value={oid} />
 <input type="hidden" name="retURL" value="https://visiondetectionsystems.com/thank-you-quote" />
 <input type="hidden" name="lead_source" value="Website — Quote Request" />
 <input type="hidden" name="Campaign_ID" value="" />
 <input type="hidden" name="utm_source" id="utm_source" />
 <input type="hidden" name="utm_medium" id="utm_medium" />
 <input type="hidden" name="utm_campaign" id="utm_campaign" />
 <input type="hidden" name="submit_page" id="submit_page" />

 <h2 class="text-h3 font-display mb-2">Request a quote</h2>
 <p class="text-sm text-slate">We respond within one business hour.</p>

 <div data-step="1" class="space-y-4">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div>
 <label for="company" class="block text-sm font-medium text-navy mb-1">Company name *</label>
 <input id="company" name="company" required class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none" />
 </div>
 <div>
 <label for="title" class="block text-sm font-medium text-navy mb-1">Your role *</label>
 <input id="title" name="title" required class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none" />
 </div>
 </div>
 <div>
 <label for="industry" class="block text-sm font-medium text-navy mb-1">Industry *</label>
 <select id="industry" name="industry" required class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none">
 <option value="">Select your industry</option>
 <option>Construction</option>
 <option>Utilities & Energy</option>
 <option>Retail</option>
 <option>Auto Dealership</option>
 <option>Parking & Garages</option>
 <option>Government / Public Safety</option>
 <option>Warehouse / Logistics</option>
 <option>Oil & Gas</option>
 <option>Events</option>
 <option>Other</option>
 </select>
 </div>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div>
 <label for="phone" class="block text-sm font-medium text-navy mb-1">Phone *</label>
 <input id="phone" name="phone" type="tel" required class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none" />
 </div>
 <div>
 <label for="email" class="block text-sm font-medium text-navy mb-1">Business email *</label>
 <input id="email" name="email" type="email" required class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none" />
 </div>
 </div>
 <button type="button" class="btn-primary w-full" data-next>Continue →</button>
 </div>

 <div data-step="2" class="space-y-4 hidden">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div>
 <label for="site_count" class="block text-sm font-medium text-navy mb-1">Number of sites *</label>
 <input id="site_count" name="00N_site_count__c" type="number" min="1" required class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none" />
 </div>
 <div>
 <label for="zip" class="block text-sm font-medium text-navy mb-1">Primary ZIP *</label>
 <input id="zip" name="zip" required pattern="\d{5}" class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none" />
 </div>
 </div>
 <div>
 <label for="duration" class="block text-sm font-medium text-navy mb-1">Project duration *</label>
 <select id="duration" name="00N_duration__c" required class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none">
 <option value="">Select</option>
 <option>1–3 months</option>
 <option>3–6 months</option>
 <option>6–12 months</option>
 <option>12+ months</option>
 <option>Ongoing program</option>
 </select>
 </div>
 <div>
 <label for="description" class="block text-sm font-medium text-navy mb-1">What are you trying to protect from?</label>
 <textarea id="description" name="description" rows="3" maxlength="600" class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none"></textarea>
 </div>
 <div class="flex gap-3">
 <button type="button" class="btn-secondary border-slate text-slate flex-1" data-back>← Back</button>
 <button type="submit" class="btn-primary flex-1">Submit request</button>
 </div>
 <p class="text-xs text-slate">By submitting you agree to be contacted by VDS. See our <a href="/privacy-policy" class="underline text-orange">privacy policy</a>.</p>
 </div>
</form>
<script>
 const form = document.getElementById('form-quote');
 if (form) {
 const s1 = form.querySelector('[data-step="1"]') as HTMLElement;
 const s2 = form.querySelector('[data-step="2"]') as HTMLElement;
 const next = form.querySelector('[data-next]');
 const back = form.querySelector('[data-back]');
 next?.addEventListener('click', () => {
 const required = s1.querySelectorAll('[required]') as NodeListOf<HTMLInputElement | HTMLSelectElement>;
 let valid = true;
 required.forEach(el => {
 if (!el.value || !el.checkValidity()) {
 valid = false;
 (el as HTMLElement).classList.add('border-red-500');
 }
 });
 if (valid) {
 s1.classList.add('hidden');
 s2.classList.remove('hidden');
 }
 });
 back?.addEventListener('click', () => {
 s2.classList.add('hidden');
 s1.classList.remove('hidden');
 });
 // Capture UTM + submit page on load
 const params = new URLSearchParams(window.location.search);
 (document.getElementById('utm_source') as HTMLInputElement).value = params.get('utm_source') || '';
 (document.getElementById('utm_medium') as HTMLInputElement).value = params.get('utm_medium') || '';
 (document.getElementById('utm_campaign') as HTMLInputElement).value = params.get('utm_campaign') || '';
 (document.getElementById('submit_page') as HTMLInputElement).value = window.location.href;
 }
</script>
