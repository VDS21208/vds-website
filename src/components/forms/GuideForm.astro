---
export interface Props { guideId: string; label?: string }
const { guideId, label = "Get the guide" } = Astro.props;
const oid = "PLACEHOLDER_SALESFORCE_OID";
const sfEndpoint = "https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8";
---
<form action={sfEndpoint} method="POST" class="bg-white border border-slate-200 rounded-md p-6 space-y-4 max-w-md">
  <input type="hidden" name="oid" value={oid} />
  <input type="hidden" name="retURL" value="https://visiondetectionsystems.com/thank-you-guide" />
  <input type="hidden" name="lead_source" value="Website — Guide Download" />
  <input type="hidden" name="00N_guide_id__c" value={guideId} />
  <input type="hidden" name="submit_page" />

  <div>
    <label class="block text-sm font-medium text-navy mb-1">Business email *</label>
    <input name="email" type="email" required class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none" />
  </div>
  <div>
    <label class="block text-sm font-medium text-navy mb-1">Company *</label>
    <input name="company" required class="w-full border border-slate-300 rounded-sm px-3 py-2 focus:border-orange focus:outline-none" />
  </div>
  <button type="submit" class="btn-primary w-full">{label} →</button>
  <p class="text-xs text-slate">No spam. One follow-up email max. <a href="/privacy-policy" class="underline text-orange">Privacy</a></p>
</form>
