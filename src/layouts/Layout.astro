---
import '../styles/global.css';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import AnnouncementBar from '../components/nav/AnnouncementBar.astro';
import SchemaOrganization from '../components/seo/SchemaOrganization.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  announcementBar?: string;
  noNav?: boolean;
  bodyClass?: string;
  parent?: string;
  h1?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = 'https://visiondetectionsystems.com/assets/og-default.jpg',
  ogType = 'website',
  robots = 'index, follow',
  announcementBar,
  noNav = false,
  bodyClass = '',
  parent,
  h1,
} = Astro.props;

const site = 'https://visiondetectionsystems.com';
const path = Astro.url.pathname;
const canonicalUrl = canonical || `${site}${path === '/' ? '' : path.replace(/\/$/, '')}`;
const finalOgTitle = ogTitle || title;
const finalOgDesc = ogDescription || description;
---
<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={`${robots}, max-image-preview:large, max-snippet:-1`} />
    <meta name="geo.region" content="US-MD" />
    <meta name="geo.placename" content="Pikesville" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="VDS Blog" href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalOgDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Vision Detection Systems" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalOgDesc} />
    <meta name="twitter:image" content={ogImage} />

    <SchemaOrganization />
    {h1 && parent && <SchemaBreadcrumb pageName={h1} pageUrl={canonicalUrl} parentName={parent} />}

    <script is:inline>
      document.addEventListener('alpine:init', () => {});
    </script>
  </head>
  <body class={`bg-white text-navy ${bodyClass}`}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {!noNav && (
      <>
        {announcementBar && <AnnouncementBar text={announcementBar} />}
        <Nav />
      </>
    )}
    <main id="main-content">
      <slot />
    </main>
    {!noNav && <Footer />}
  </body>
</html>
